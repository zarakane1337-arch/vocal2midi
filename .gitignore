# ═══ Python 字节码 ═══════════════════════════════════════════════════════
# 导入包时自动生成（跑一次 import 就会出现在 src\vocal2midi\ 下）
__pycache__/
*.pyc

# ═══ 虚拟环境 ════════════════════════════════════════════════════════════
# 开发机上的解释器，约 5.7 GB（torch 2.9.1+cu128 与 PySide6 占大头）
.venv/

# ═══ 构建过程与产物 ══════════════════════════════════════════════════════
# 本仓库只收录源代码，不收录打包方式与产物。
#   installer\  C# 启动器源码、Inno Setup 脚本、构建脚本
#   tools\      图标生成脚本
#   build\      build_installer.ps1 的输出：payload 21.8 MB + setup.exe 10.8 MB
installer/
tools/
build/

# ═══ 模型权重 ════════════════════════════════════════════════════════════
# htdemucs_ft 的 5 个 .th 共 401 MB，只有这一种权重格式。
# 安装版由 core/weights.py 首次分离时自动下载，仓库里不留副本。
models/**/*.th

# ═══ 下载缓存 ════════════════════════════════════════════════════════════
# .cache\installer\   python embed zip（构建时下载，11 MB）
# .cache\wheels\      依赖 wheel（安装时下载）
.cache/

# ═══ 会话进度 ════════════════════════════════════════════════════════════
.dsh-progress/
