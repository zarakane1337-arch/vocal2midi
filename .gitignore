# ═══ Python 运行时 ════════════════════════════════════════════════════════
# 导入包时自动生成，跑一次 import 就会出现在 src/vocal2midi/ 下。
__pycache__/
*.pyc

# ═══ 依赖与虚拟环境 ════════════════════════════════════════════════════════
# 开发机上的解释器，约 5.5 GB（torch 2.9.1+cu128 与 PySide6 占大头）。
# 测试与开发命令都写死了这个路径（.venv/Scripts/python.exe），不要挪。
.venv/

# ═══ 构建产物 ═════════════════════════════════════════════════════════════
# 本仓库只收录可维护的源码，不收录打包方式与打包结果。
#   installer/  C# 启动器、Inno Setup 脚本、build_installer.ps1
#   tools/      图标生成脚本
#   build/      build_installer.ps1 的输出（payload/ 与 setup.exe）
installer/
tools/
build/

# ═══ 本地产物与缓存 ════════════════════════════════════════════════════════
# out/   转换产物（wav / mid / csv），默认输出根目录
# .cache/ 下载缓存与测试临时目录；installer/ 下那个 python embed zip 会被构建脚本复用
out/
.cache/

# 会话进度与本地草稿：DSH 的运行产物，不属于项目源码。
.dsh-progress/
# .scratch/ 是本地 issue tracker（spec 与工单）与一次性探针脚本。
.scratch/

# 并行开发用的 git worktree（每个工单一个）。
.worktrees/

# DSH 编辑器写入时的临时文件。
.dsh-ops-update-*.lock

# ═══ 本地生成的说明文件 ════════════════════════════════════════════════════
# 由本地技能配置生成，不属于项目源码。
AGENTS.md
docs/agents/

# ═══ 模型权重 ═════════════════════════════════════════════════════════════
# htdemucs_ft 的 5 个 .th 共 401 MB，安装版首次分离时下载到
# %LOCALAPPDATA%\vocal2midi\cache\torch。仓库里不留副本。
models/

# ═══ 已知无法删除的历史残留 ═══════════════════════════════════════════════
# pytest 缓存插件曾在受限环境里建出这类目录，建得出来却删不掉（权限项缺失）。
# 现在 tests/conftest.py 已把临时目录移出仓库根目录，不会再生成；
# 这条规则只是防止将来复发时把它们带进版本库。
pytest-cache-files-*/
