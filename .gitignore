# ═══ Python 字节码 ═══════════════════════════════════════════════════════
# 导入包时自动生成（跑一次 import 就会出现在 src\vocal2midi\ 下）
__pycache__/
*.pyc

# ═══ 虚拟环境 ════════════════════════════════════════════════════════════
# 开发机上的解释器，约 5.7 GB（torch 2.9.1+cu128 与 PySide6 占大头）
.venv/

# ═══ 工具生成的说明文件 ══════════════════════════════════════════════════
# AGENTS.md、docs/agents/ 由本地技能配置生成，不属于项目源码。
# docs/agents/ 由本地技能配置生成的文档
AGENTS.md
docs/agents/

# ═══ 构建过程与产物 ══════════════════════════════════════════════════════
# 本仓库只收录源代码，不收录打包方式与产物。
#   installer\  C# 启动器源码、Inno Setup 脚本、构建脚本
#   tools\      图标生成脚本
#   build\      build_installer.ps1 的输出（payload/ 与 setup.exe）
#   out\        输出的wav/mid文件
installer/
tools/
build/
out/

# pip 在仓库根目录残留的临时目录（安装中断时留下，形如 pip-install-xxxx）
pip-*/

# pytest 在受限环境里建不出来的临时目录残留（见 tests/conftest.py 的说明）
pytest-cache-files-*/

# DSH 编辑器写入时的临时文件
.dsh-ops-update-*.lock

# DSH 插件的本地链接目录（profile 里以 junction 指向这里，不属于本项目源码）
plugins/

# ═══ 模型权重 ════════════════════════════════════════════════════════════
# htdemucs_ft 的 5 个 .th 共 401 MB。
# 安装版由 core/weights.py 首次分离时下载到 %LOCALAPPDATA%\vocal2midi\cache\torch，
# 仓库里不留副本，开发机也不该在仓库内再放一份。
models/

# ═══ 下载缓存 ════════════════════════════════════════════════════════════
# .cache\installer\   python embed zip（构建时下载，11 MB，构建脚本会复用）
.cache/

# ═══ 会话进度 ════════════════════════════════════════════════════════════
.dsh-progress/

# ═══ 并行开发的 git worktree ═════════════════════════════════════════════
# /to-tickets 的每个工单在独立 worktree 里实现，不属于项目源码。
.worktrees/
# ═══ 本地草稿与工单 ══════════════════════════════════════════════════════
# .scratch/ 是本地 issue tracker（spec 与工单）与临时草稿，不进版本库。
.scratch/
